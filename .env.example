# Telegram
TELEGRAM_BOT_TOKEN=your-bot-token-here

# Google Sheets
GOOGLE_SPREADSHEET_ID=your-spreadsheet-id-here
GOOGLE_WORKSHEET_NAME=Links

# /garchive command – worksheets used to move DOWNLOADED items
GOOGLE_STREAM_WORKSHEET_NAME=stream
GOOGLE_ARCHIVE_WORKSHEET_NAME=archive
GOOGLE_DOWNLOADED_STATUS=DOWNLOADED

# Service account credentials – provide ONE of these:
GOOGLE_SA_KEY_FILE=path/to/service-account.json
# GOOGLE_SA_KEY_JSON={"type":"service_account", ...}

# Logging
LOG_LEVEL=INFO

# S3
S3_BUCKET=your-bucket-name-here
